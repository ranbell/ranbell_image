# Copy to .env.

# Host folder ranbell exports LoRA datasets to — the same folder that is
# mounted into ranbell's backend as /mnt/lora_export.
LORA_DATASETS_DIR=/path/to/lora/datasets

# The trainer frees these before it starts, because they share the same card.
COMFYUI_URL=http://host.docker.internal:8188
OLLAMA_URL=http://host.docker.internal:11434

# Only needed if setup should fetch gated models itself (it does not by default).
# HF_TOKEN=
